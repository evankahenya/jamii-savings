<?xml version="1.0" encoding="UTF-8"?>
<endpoint xmlns="http://ws.apache.org/ns/synapse" name="LoansEligibilityInternalEP">
    <!-- LoansEligibilityAPI (Part 1 API) called by LoanApplicationConsumer.
         The URL comes from ${configs.loans_eligibility_url} (env var loans_eligibility_url, default
         http://localhost:8290/loans/eligibility) and is put in uri.var.loansEligibilityUrl by the consumer.
         Timeout is above the API's own 10s backend timeout so the API can answer with its 503/504 first.
         No suspension: every failed call should go through the consumer's own retry queue logic -->
    <http method="post" uri-template="{uri.var.loansEligibilityUrl}">
        <timeout>
            <duration>15000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <errorCodes>-1</errorCodes>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <errorCodes>-1</errorCodes>
        </markForSuspension>
    </http>
</endpoint>
