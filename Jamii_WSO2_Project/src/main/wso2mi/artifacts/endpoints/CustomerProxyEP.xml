<?xml version="1.0" encoding="UTF-8"?>
<endpoint xmlns="http://ws.apache.org/ns/synapse" name="CustomerProxyEP">
    <!-- longer timeout than ReqresCustomerEP so backend timeouts surface as the proxy's 504 -->
    <http method="get" uri-template="http://localhost:8290/services/CustomerProxy/{uri.var.customerId}">
        <timeout>
            <duration>15000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
        <suspendOnFailure>
            <initialDuration>-1</initialDuration>
            <progressionFactor>1</progressionFactor>
        </suspendOnFailure>
    </http>
</endpoint>
