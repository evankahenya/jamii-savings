<?xml version="1.0" encoding="UTF-8"?>
<endpoint xmlns="http://ws.apache.org/ns/synapse" name="AccountDataServiceEP">
    <!-- shorter timeout than AccountBalanceAPIEP so a slow DB returns 503 -->
    <http method="get" uri-template="http://localhost:8290/services/AccountDataService/accounts/{uri.var.accountNumber}">
        <timeout>
            <duration>5000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>-1</initialDuration>
            <progressionFactor>1</progressionFactor>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
