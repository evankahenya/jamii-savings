<?xml version="1.0" encoding="UTF-8"?>
<!-- Customer information for Jamii Savings (one API, two resources):
       GET /customers/{customerId}            customer record from the CRM backend via CustomerProxy (Part 1b)
       GET /customers/{customerId}/dashboard  customer + all account balances, fetched in parallel (Bonus A)
     The dashboard resource is listed first so the more specific path is matched first. -->
<api xmlns="http://ws.apache.org/ns/synapse" name="CustomersAPI" context="/customers">

    <resource methods="GET" uri-template="/{customerId}/dashboard">
        <inSequence>
            <property name="artifactName" scope="default" type="STRING" value="CustomersAPI"/>
            <sequence key="CorrelationIdSeq"/>
            <variable name="customerId" type="STRING" expression="$ctx:uri.var.customerId"/>

            <log category="INFO">
                <message>[CustomersAPI dashboard] Request received | correlationId=${properties.synapse.correlationId}</message>
            </log>

            <!-- same check as the customer lookup below: customerId must be a UUID -->
            <filter source="$ctx:uri.var.customerId" regex="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$">
                <then>
                    <variable name="customerIdMasked" type="STRING"
                              expression="${subString(vars.customerId, 0, 8) + '-****-****-****-********' + subString(vars.customerId, 32)}"/>
                </then>
                <else>
                    <log category="WARN">
                        <message>[CustomersAPI dashboard] Validation failed: customerId must be a UUID | correlationId=${properties.synapse.correlationId}</message>
                    </log>
                    <property name="errorStatus" value="400"/>
                    <property name="errorMessage" value="Invalid customerId. Expected a UUID."/>
                    <sequence key="ErrorResponseSeq"/>
                </else>
            </filter>

            <!-- 1. get the customer. uri.var.customerId comes from the path so CustomerProxyEP picks it up -->
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="Accept" scope="transport" value="application/json"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

            <log category="INFO">
                <message>[CustomersAPI dashboard] Getting customer | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked}</message>
            </log>
            <call>
                <endpoint key="CustomerProxyEP"/>
            </call>
            <property name="customerStatus" expression="$axis2:HTTP_SC"/>
            <log category="INFO">
                <message>[CustomersAPI dashboard] Customer lookup responded | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked} | status=${properties.synapse.customerStatus}</message>
            </log>

            <!-- no customer means no dashboard, so these fail the whole request -->
            <switch source="get-property('customerStatus')">
                <case regex="200"/>
                <case regex="404">
                    <property name="errorStatus" value="404"/>
                    <property name="errorMessage" value="Customer not found"/>
                    <sequence key="ErrorResponseSeq"/>
                </case>
                <case regex="503|504">
                    <property name="errorStatus" expression="get-property('customerStatus')"/>
                    <property name="errorMessage" value="Customer service is unavailable. Try again later"/>
                    <sequence key="ErrorResponseSeq"/>
                </case>
                <default>
                    <log category="ERROR">
                        <message>[CustomersAPI dashboard] Unexpected status from customer lookup, responding HTTP 502 | correlationId=${properties.synapse.correlationId} | status=${properties.synapse.customerStatus}</message>
                    </log>
                    <property name="errorStatus" value="502"/>
                    <property name="errorMessage" value="Bad gateway. Unexpected response from customer service"/>
                    <sequence key="ErrorResponseSeq"/>
                </default>
            </switch>

            <!-- keep the customer record for the final response -->
            <variable name="customer" type="JSON" expression="${payload.data.data}"/>

            <!-- 2. get the balance of every account in the customer's account_number list -->
            <variable name="accounts" type="JSON" value="[]"/>
            <filter xpath="${exists(payload.data.data.account_number)}">
                <then>
                    <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
                    <header name="Accept" scope="transport" value="application/json"/>
                    <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

                    <!-- each account is called at the same time, the results are collected into vars.accounts -->
                    <foreach collection="${payload.data.data.account_number}" parallel-execution="true"
                             update-original="false" target-variable="accounts" result-content-type="JSON">
                        <sequence>
                            <variable name="accountNumber" type="STRING" expression="${payload}"/>
                            <property name="uri.var.accountNumber" expression="${vars.accountNumber}"/>
                            <call>
                                <endpoint key="AccountBalanceAPIEP"/>
                            </call>

                            <!-- if this account fails we still return the rest of the dashboard,
                                 the account is just marked as UNAVAILABLE -->
                            <filter xpath="${properties.axis2.HTTP_SC != 200}">
                                <then>
                                    <log category="WARN">
                                        <message>[CustomersAPI dashboard] Could not get balance for account | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked} | accountNumber=${vars.accountNumber} | status=${properties.axis2.HTTP_SC}</message>
                                    </log>
                                    <payloadFactory media-type="json">
                                        <format>{
                                                        "accountNumber": "${vars.accountNumber}",
                                                        "status": "UNAVAILABLE",
                                                        "error": "Balance could not be retrieved for this account",
                                                        "code": ${properties.axis2.HTTP_SC}
}</format>
                                    </payloadFactory>
                                </then>
                                <else/>
                            </filter>
                        </sequence>
                    </foreach>
                </then>
                <else>
                    <log category="WARN">
                        <message>[CustomersAPI dashboard] Customer has no accounts | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked}</message>
                    </log>
                </else>
            </filter>

            <!-- 3. put it all together -->
            <payloadFactory media-type="json">
                <format>{
                                        "customerId": "${vars.customerId}",
                                        "customer": ${vars.customer},
                                        "accounts": ${vars.accounts},
                                        "requestId": "${properties.synapse.correlationId}",
                                        "timestamp": "${properties.synapse.requestTimestamp}"
}</format>
            </payloadFactory>

            <property name="messageType" value="application/json" scope="axis2"/>
            <property name="HTTP_SC" value="200" scope="axis2"/>
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

            <log category="INFO">
                <message>[CustomersAPI dashboard] Response sent | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked} | status=200</message>
            </log>
            <respond/>
        </inSequence>
        <faultSequence>
            <sequence key="GatewayFaultSeq"/>
        </faultSequence>
    </resource>

    <resource methods="GET" uri-template="/{customerId}">
        <inSequence>
            <!--inform fault sequence which api is currently runinning-->
            <property name="artifactName" scope="default" type="STRING" value="CustomersAPI"/>
            <!--Start the Correlation ID sequence which checks if the request has a correlationID-->
            <sequence key="CorrelationIdSeq"/>
            <variable name="customerId" type="STRING" expression="$ctx:uri.var.customerId"/>

            <log category="INFO">
                <message>[CustomersAPI lookup] Request received | correlationId=${properties.synapse.correlationId} | correlationIdSource=${properties.synapse.correlationIdSource} | timestamp=${properties.synapse.requestTimestamp}</message>
            </log>

            <!-- Validate customerId (valid uuid)-->
            <filter source="$ctx:uri.var.customerId" regex="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$">
                <then>
                    <!--if customerId is valid then masking for discrete logging-->
                    <variable name="customerIdMasked" type="STRING"
                              expression="${subString(vars.customerId, 0, 8) + '-****-****-****-********' + subString(vars.customerId, 32)}"/>
                </then>
                <else>
                    <log category="ERROR">
                        <message>[CustomersAPI lookup] Validation failed: customerId must be a UUID, responding HTTP 400 | correlationId=${properties.synapse.correlationId}</message>
                    </log>
                    <property name="HTTP_SC" value="400" scope="axis2"/>
                    <payloadFactory media-type="json">
                        <format>{"error":"Invalid customerId. Expected a UUID.","code":400,"requestId":"${properties.synapse.correlationId}","timestamp":"${properties.synapse.requestTimestamp}"}</format>
                    </payloadFactory>
                    <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
                    <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>
                    <respond/>
                </else>
            </filter>

            <!-- Strip all headers -->
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="Accept" scope="transport" value="application/json"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

            <log category="INFO">
                <message>[CustomersAPI lookup] Forwarding to CustomerProxy | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked}</message>
            </log>
            <call>
                <endpoint key="CustomerProxyEP"/>
            </call>
            <log category="INFO">
                <message>[CustomersAPI lookup] CustomerProxy responded | correlationId=${properties.synapse.correlationId} | customerId=${vars.customerIdMasked} | status=${properties.axis2.HTTP_SC}</message>
            </log>

            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>
    
            <respond/>
        </inSequence>

        <faultSequence>
            <sequence key="GatewayFaultSeq"/>
        </faultSequence>
    </resource>
</api>
