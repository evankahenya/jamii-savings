<?xml version="1.0" encoding="UTF-8"?>
<!-- Loans for Jamii Savings (one API, two resources):
       POST /loans/eligibility   REST/JSON -> SOAP eligibility check -> JSON (Part 1c)
       POST /loans/applications  validates a loan application and queues it on LoanApplicationsQueue (Bonus B);
                                 LoanApplicationConsumer then calls /loans/eligibility asynchronously
     Each resource also has a catch-all for other HTTP methods that answers 405. -->
<api xmlns="http://ws.apache.org/ns/synapse" name="LoansAPI" context="/loans">

    <resource methods="POST" uri-template="/eligibility">
        <inSequence>
            <property name="artifactName" scope="default" type="STRING" value="LoansAPI"/>
            <sequence key="CorrelationIdSeq"/>
            <log category="INFO">
                <message>[LoansAPI eligibility] Request received | correlationId=${properties.synapse.correlationId}</message>
            </log>

            <!-- only accept JSON requests -->
            <filter source="$trp:Content-Type" regex="application/json.*">
                <then/>
                <else>
                    <log category="WARN">
                        <message>[LoansAPI eligibility] Request is not JSON | correlationId=${properties.synapse.correlationId} | contentType=${headers["Content-Type"]}</message>
                    </log>
                    <property name="errorStatus" value="415"/>
                    <property name="errorMessage" value="Unsupported body type. Request must be application/json"/>
                    <sequence key="ErrorResponseSeq"/>
                </else>
            </filter>

            <!-- if the body is broken JSON the validate step below throws an error and we end up in the
                 faultSequence. This flag tells the faultSequence it was a bad request and not a server error -->
            <property name="checkingRequest" value="true"/>

            <!-- Validate request using JSON schema (schemas/LoansEligibilityRequest.json) -->
            <validate>
                <schema key="gov:mi-resources/schemas/LoansEligibilityRequest.json"/>
                <on-fail>
                    <log category="WARN">
                        <message>[LoansAPI eligibility] Validation failed | correlationId=${properties.synapse.correlationId} | reason=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="errorStatus" value="400"/>
                    <property name="errorMessage" value="Invalid request. One or more fields are missing or invalid"/>
                    <sequence key="ErrorResponseSeq"/>
                </on-fail>
            </validate>
            <property name="checkingRequest" value="false"/>

            <!-- email and other income are optional -->
            <variable name="email" type="STRING"
                      expression="${exists(payload.applicant.emailAddress) ? payload.applicant.emailAddress : ''}"/>
            <variable name="otherIncome" type="STRING"
                      expression="${exists(payload.employmentDetails.otherMonthlyIncome) ? payload.employmentDetails.otherMonthlyIncome.amount : 0}"/>

            <!-- build the SOAP request for the backend -->
            <payloadFactory media-type="xml">
                <format>
                    <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:v1="https://api.example.co.ke/loan/eligibility/v1">
                        <soapenv:Header/>
                        <soapenv:Body>
                            <v1:CheckLoanEligibilityRequest>
                                <v1:requestHeader>
                                    <v1:channelId>${payload.channelId}</v1:channelId>
                                    <v1:requestId>${properties.synapse.correlationId}</v1:requestId>
                                    <v1:correlationId>${properties.synapse.correlationId}</v1:correlationId>
                                    <v1:requestTimestamp>${properties.synapse.requestTimestamp}</v1:requestTimestamp>
                                    <v1:sourceSystem>JAMII_MI</v1:sourceSystem>
                                </v1:requestHeader>
                                <v1:applicant>
                                    <v1:customerReference>${payload.applicant.customerReference}</v1:customerReference>
                                    <v1:firstName>${payload.applicant.firstName}</v1:firstName>
                                    <v1:lastName>${payload.applicant.lastName}</v1:lastName>
                                    <v1:nationalIdLastFour>${payload.applicant.nationalIdLastFour}</v1:nationalIdLastFour>
                                    <v1:kraPin>${payload.applicant.kraPin}</v1:kraPin>
                                    <v1:dateOfBirth>${payload.applicant.dateOfBirth}</v1:dateOfBirth>
                                    <v1:mobileNumber>${payload.applicant.mobileNumber}</v1:mobileNumber>
                                    <v1:emailAddress>${vars.email}</v1:emailAddress>
                                    <v1:county>${payload.applicant.county}</v1:county>
                                    <v1:residencyStatus>${payload.applicant.residencyStatus}</v1:residencyStatus>
                                </v1:applicant>
                                <v1:employmentDetails>
                                    <v1:employmentType>${payload.employmentDetails.employmentType}</v1:employmentType>
                                    <v1:employerOrBusinessName>${payload.employmentDetails.employerOrBusinessName}</v1:employerOrBusinessName>
                                    <v1:monthsWithEmployerOrBusiness>${payload.employmentDetails.monthsWithEmployerOrBusiness}</v1:monthsWithEmployerOrBusiness>
                                    <v1:monthlyGrossIncome>
                                        <v1:amount>${payload.employmentDetails.monthlyGrossIncome.amount}</v1:amount>
                                        <v1:currency>${payload.employmentDetails.monthlyGrossIncome.currency}</v1:currency>
                                    </v1:monthlyGrossIncome>
                                    <v1:monthlyNetIncome>
                                        <v1:amount>${payload.employmentDetails.monthlyNetIncome.amount}</v1:amount>
                                        <v1:currency>${payload.employmentDetails.monthlyNetIncome.currency}</v1:currency>
                                    </v1:monthlyNetIncome>
                                    <v1:otherMonthlyIncome>
                                        <v1:amount>${vars.otherIncome}</v1:amount>
                                        <v1:currency>KES</v1:currency>
                                    </v1:otherMonthlyIncome>
                                    <v1:incomeVerified>${payload.employmentDetails.incomeVerified}</v1:incomeVerified>
                                </v1:employmentDetails>
                                <v1:loanRequest>
                                    <v1:productCode>${payload.loanRequest.productCode}</v1:productCode>
                                    <v1:requestedAmount>
                                        <v1:amount>${payload.loanRequest.requestedAmount.amount}</v1:amount>
                                        <v1:currency>${payload.loanRequest.requestedAmount.currency}</v1:currency>
                                    </v1:requestedAmount>
                                    <v1:requestedTenorMonths>${payload.loanRequest.requestedTenorMonths}</v1:requestedTenorMonths>
                                    <v1:purpose>${payload.loanRequest.purpose}</v1:purpose>
                                    <v1:repaymentMethod>${payload.loanRequest.repaymentMethod}</v1:repaymentMethod>
                                    <v1:existingObligations>
                                        <v1:monthlyLoanRepayments>
                                            <v1:amount>${payload.loanRequest.existingObligations.monthlyLoanRepayments.amount}</v1:amount>
                                            <v1:currency>${payload.loanRequest.existingObligations.monthlyLoanRepayments.currency}</v1:currency>
                                        </v1:monthlyLoanRepayments>
                                        <v1:monthlyMobileLoanRepayments>
                                            <v1:amount>${payload.loanRequest.existingObligations.monthlyMobileLoanRepayments.amount}</v1:amount>
                                            <v1:currency>${payload.loanRequest.existingObligations.monthlyMobileLoanRepayments.currency}</v1:currency>
                                        </v1:monthlyMobileLoanRepayments>
                                        <v1:monthlyOtherDebtPayments>
                                            <v1:amount>${payload.loanRequest.existingObligations.monthlyOtherDebtPayments.amount}</v1:amount>
                                            <v1:currency>${payload.loanRequest.existingObligations.monthlyOtherDebtPayments.currency}</v1:currency>
                                        </v1:monthlyOtherDebtPayments>
                                        <v1:hasOverdueFacility>${payload.loanRequest.existingObligations.hasOverdueFacility}</v1:hasOverdueFacility>
                                        <v1:daysPastDue>${payload.loanRequest.existingObligations.daysPastDue}</v1:daysPastDue>
                                    </v1:existingObligations>
                                </v1:loanRequest>
                                <v1:consentToCreditAssessment>${payload.consentToCreditAssessment}</v1:consentToCreditAssessment>
                            </v1:CheckLoanEligibilityRequest>
                        </soapenv:Body>
                    </soapenv:Envelope>
                </format>
            </payloadFactory>

            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <property name="messageType" value="text/xml" scope="axis2"/>
            <header name="Action" value="CheckLoanEligibility"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

            <call>
                <endpoint key="LoanEligibilitySoapEP"/>
            </call>

            <property name="backendStatus" expression="$axis2:HTTP_SC"/>
            <log category="INFO">
                <message>[LoansAPI eligibility] Backend responded | correlationId=${properties.synapse.correlationId} | backendStatus=${properties.synapse.backendStatus}</message>
            </log>

            <!-- anything other than 200 from the backend is a 502 -->
            <filter source="get-property('backendStatus')" regex="200">
                <then/>
                <else>
                    <property name="errorStatus" value="502"/>
                    <property name="errorMessage" value="Bad gateway. Unexpected response from loan service"/>
                    <sequence key="ErrorResponseSeq"/>
                </else>
            </filter>

            <!-- Valid soap response from backend using XML Schema Definition file (schema/LoansEligibilityResponse.xsd) -->
            <validate source="$body/jam:CheckLoanEligibilityResponse" xmlns:jam="http://jamii.loans.app/schema">
                <schema key="gov:mi-resources/schemas/LoansEligibilityResponse.xsd"/>
                <on-fail>
                    <log category="ERROR">
                        <message>[LoansAPI eligibility] Backend response validation failed | correlationId=${properties.synapse.correlationId} | reason=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="errorStatus" value="502"/>
                    <property name="errorMessage" value="Bad gateway. Unexpected response from loan service"/>
                    <sequence key="ErrorResponseSeq"/>
                </on-fail>
            </validate>

            <!-- read the values we need from the SOAP response -->
            <property name="status" expression="$body/jam:CheckLoanEligibilityResponse/Status" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="riskBand" expression="$body/jam:CheckLoanEligibilityResponse/RiskBand" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="requestedAmount" expression="$body/jam:CheckLoanEligibilityResponse/RequestedAmount" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="requestedCurrency" expression="$body/jam:CheckLoanEligibilityResponse/RequestedAmount/@currency" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="indicativeAmount" expression="$body/jam:CheckLoanEligibilityResponse/IndicativeAmount" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="indicativeCurrency" expression="$body/jam:CheckLoanEligibilityResponse/IndicativeAmount/@currency" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="tenorMonths" expression="$body/jam:CheckLoanEligibilityResponse/TenorMonths" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="instalment" expression="$body/jam:CheckLoanEligibilityResponse/Instalment" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="instalmentCurrency" expression="$body/jam:CheckLoanEligibilityResponse/Instalment/@currency" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="dti" expression="$body/jam:CheckLoanEligibilityResponse/DebtToIncomeRatio" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="reasons" expression="$body/jam:CheckLoanEligibilityResponse/Reasons" xmlns:jam="http://jamii.loans.app/schema"/>
            <property name="nextSteps" expression="$body/jam:CheckLoanEligibilityResponse/NextSteps" xmlns:jam="http://jamii.loans.app/schema"/>

            <!-- build the JSON response-->
            <payloadFactory media-type="json">
                <format>{
                            "status": "${properties.synapse.status}",
                            "riskBand": "${properties.synapse.riskBand}",
                            "requestedAmount": {
                                "amount": ${properties.synapse.requestedAmount},
                                "currency": "${properties.synapse.requestedCurrency}"
                            },
                            "indicativeAmount": {
                                "amount": ${properties.synapse.indicativeAmount},
                                "currency": "${properties.synapse.indicativeCurrency}"
                            },
                            "tenorMonths": ${properties.synapse.tenorMonths},
                            "instalment": {
                                "amount": ${properties.synapse.instalment},
                                "currency": "${properties.synapse.instalmentCurrency}"
                            },
                            "debtToIncomeRatio": ${properties.synapse.dti},
                            "reasons": "${properties.synapse.reasons}",
                            "nextSteps": "${properties.synapse.nextSteps}",
                            "requestId": "${properties.synapse.correlationId}",
                            "timestamp": "${properties.synapse.requestTimestamp}"
}</format>
            </payloadFactory>

            <property name="messageType" value="application/json" scope="axis2"/>
            <property name="HTTP_SC" value="200" scope="axis2"/>
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>

            <log category="INFO">
                <message>[LoansAPI eligibility] Response sent | correlationId=${properties.synapse.correlationId} | status=${properties.synapse.status}</message>
            </log>
            <respond/>
        </inSequence>
        <faultSequence>
            <!-- broken JSON body gives a 400, anything else goes to the normal fault handling -->
            <filter source="get-property('checkingRequest')" regex="true">
                <then>
                    <log category="WARN">
                        <message>[LoansAPI eligibility] Request body is not valid JSON | correlationId=${properties.synapse.correlationId} | error=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="errorStatus" value="400"/>
                    <property name="errorMessage" value="Invalid request. Body is not valid JSON"/>
                    <sequence key="ErrorResponseSeq"/>
                </then>
                <else>
                    <sequence key="GatewayFaultSeq"/>
                </else>
            </filter>
        </faultSequence>
    </resource>

    <!-- only POST is allowed -->
    <resource methods="GET PUT DELETE PATCH" uri-template="/eligibility">
        <inSequence>
            <sequence key="CorrelationIdSeq"/>
            <property name="errorStatus" value="405"/>
            <property name="errorMessage" value="Method not allowed. Use POST"/>
            <property name="NO_ENTITY_BODY" action="remove" scope="axis2"/>
            <sequence key="ErrorResponseSeq"/>
        </inSequence>
    </resource>

    <!-- Entry point for loan applications. Validates the request, wraps it in a LoanApplicationSubmitted
         event and publishes it to LoanApplicationsQueue, then answers 202 straight away.
         The eligibility check happens later in LoanApplicationConsumer (see docs/loan-application-queue.md) -->
    <resource methods="POST" uri-template="/applications">
        <inSequence>
            <property name="artifactName" scope="default" type="STRING" value="LoansAPI"/>
            <sequence key="CorrelationIdSeq"/>
            <log category="INFO">
                <message>[LoansAPI applications] Request received | correlationId=${properties.synapse.correlationId}</message>
            </log>

            <!-- only accept JSON requests -->
            <filter source="$trp:Content-Type" regex="application/json.*">
                <then/>
                <else>
                    <log category="WARN">
                        <message>[LoansAPI applications] Request is not JSON | correlationId=${properties.synapse.correlationId} | contentType=${headers["Content-Type"]}</message>
                    </log>
                    <property name="errorStatus" value="415"/>
                    <property name="errorMessage" value="Unsupported body type. Request must be application/json"/>
                    <sequence key="ErrorResponseSeq"/>
                </else>
            </filter>

            <!-- broken JSON makes validate throw -> faultSequence answers 400 when this flag is set -->
            <property name="checkingRequest" value="true"/>
            <validate>
                <schema key="gov:mi-resources/schemas/LoanApplicationRequest.json"/>
                <on-fail>
                    <log category="WARN">
                        <message>[LoansAPI applications] Validation failed | correlationId=${properties.synapse.correlationId} | reason=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="errorStatus" value="400"/>
                    <property name="errorMessage" value="Invalid request. One or more fields are missing or invalid"/>
                    <!-- the schema error text contains double quotes, which would break the JSON error body -->
                    <property name="errorDetails" expression="${replace(properties.synapse.ERROR_MESSAGE, '&quot;', &quot;'&quot;)}"/>
                    <sequence key="ErrorResponseSeq"/>
                </on-fail>
            </validate>
            <property name="checkingRequest" value="false"/>

            <!-- the correlation ID becomes the eventId / applicationId, so one ID is used end to end.
                 Sent as text so it shows up as a readable TextMessage in the ActiveMQ console -->
            <payloadFactory media-type="text">
                <format>{"eventId":"${properties.synapse.correlationId}","eventType":"LoanApplicationSubmitted","submittedAt":"${properties.synapse.requestTimestamp}","customer":${payload.customer},"employment":${payload.employment},"loan":${payload.loan}}</format>
            </payloadFactory>
            <property name="messageType" value="text/plain" scope="axis2"/>
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="correlationId" scope="transport" expression="${properties.synapse.correlationId}"/>
            <header name="eventType" scope="transport" value="LoanApplicationSubmitted"/>
            <header name="contentType" scope="transport" value="application/json"/>

            <property name="publishing" value="true"/>
            <property name="OUT_ONLY" value="true"/>
            <call>
                <endpoint key="LoanApplicationsQueueEP"/>
            </call>
            <property name="OUT_ONLY" action="remove"/>
            <property name="publishing" value="false"/>
            <log category="INFO">
                <message>[LoansAPI applications] Application queued on LoanApplicationsQueue | correlationId=${properties.synapse.correlationId}</message>
            </log>

            <!-- 202: accepted for processing, the decision is published later on LoanDecisionsQueue -->
            <payloadFactory media-type="json">
                <format>{"applicationId":"${properties.synapse.correlationId}","status":"RECEIVED","message":"Loan application received. Eligibility will be checked shortly.","timestamp":"${properties.synapse.requestTimestamp}"}</format>
            </payloadFactory>
            <property name="messageType" value="application/json" scope="axis2"/>
            <property name="HTTP_SC" value="202" scope="axis2"/>
            <property name="TRANSPORT_HEADERS" action="remove" scope="axis2"/>
            <header name="X-Correlation-ID" scope="transport" expression="${properties.synapse.correlationId}"/>
            <respond/>
        </inSequence>
        <faultSequence>
            <filter source="get-property('checkingRequest')" regex="true">
                <then>
                    <log category="WARN">
                        <message>[LoansAPI applications] Request body is not valid JSON | correlationId=${properties.synapse.correlationId} | error=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="errorStatus" value="400"/>
                    <property name="errorMessage" value="Invalid request. Body is not valid JSON"/>
                    <sequence key="ErrorResponseSeq"/>
                </then>
            </filter>
            <!-- broker down / unreachable: nothing was queued, tell the caller to try again -->
            <filter source="get-property('publishing')" regex="true">
                <then>
                    <log category="ERROR">
                        <message>[LoansAPI applications] Could not publish to LoanApplicationsQueue | correlationId=${properties.synapse.correlationId} | error=${properties.synapse.ERROR_MESSAGE}</message>
                    </log>
                    <property name="OUT_ONLY" action="remove"/>
                    <property name="errorStatus" value="503"/>
                    <property name="errorMessage" value="Service unavailable. The application could not be queued, please try again"/>
                    <sequence key="ErrorResponseSeq"/>
                </then>
            </filter>
            <sequence key="GatewayFaultSeq"/>
        </faultSequence>
    </resource>

    <!-- only POST is allowed -->
    <resource methods="GET PUT DELETE PATCH" uri-template="/applications">
        <inSequence>
            <sequence key="CorrelationIdSeq"/>
            <property name="errorStatus" value="405"/>
            <property name="errorMessage" value="Method not allowed. Use POST"/>
            <property name="NO_ENTITY_BODY" action="remove" scope="axis2"/>
            <sequence key="ErrorResponseSeq"/>
        </inSequence>
    </resource>
</api>
