# prod - placeholder
ENV_NAME=prod
COMPOSE_PROJECT_NAME=jamii-prod

APIM_IMAGE=wso2/wso2am:4.7.0
MI_BASE_IMAGE=wso2/wso2mi:4.6.0
ACTIVEMQ_IMAGE=apache/activemq-classic:5.18.7
SQLITE_IMAGE=keinos/sqlite3:3.46.1
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21

# dev ports + 20000
APIM_PORT_CONSOLE=29443
APIM_PORT_GW_HTTP=28280
APIM_PORT_GW_HTTPS=28243
MI_PORT_HTTP=28290
MI_PORT_HTTPS=28253
MI_PORT_MGMT=29164
AMQ_PORT_OPENWIRE=61618
AMQ_PORT_CONSOLE=28161

APIM_JAVA_OPTS=-Xms2g -Xmx4g
APIM_MEM_LIMIT=5g
MI_JAVA_OPTS=-Xms1g -Xmx2g
MI_MEM_LIMIT=2500m
AMQ_JAVA_MEMORY=-Xms256m -Xmx1g
AMQ_MEM_LIMIT=1500m
