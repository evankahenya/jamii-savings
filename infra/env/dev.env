# dev - same values as the defaults in compose.yaml
ENV_NAME=dev
COMPOSE_PROJECT_NAME=jamii-dev

# Image versions
APIM_IMAGE=wso2/wso2am:4.7.0
MI_BASE_IMAGE=wso2/wso2mi:4.6.0
ACTIVEMQ_IMAGE=apache/activemq-classic:5.18.7
SQLITE_IMAGE=keinos/sqlite3:3.46.1
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21

# Host ports
APIM_PORT_CONSOLE=9443
APIM_PORT_GW_HTTP=8280
APIM_PORT_GW_HTTPS=8243
MI_PORT_HTTP=8290
MI_PORT_HTTPS=8253
MI_PORT_MGMT=9164
AMQ_PORT_OPENWIRE=61616
AMQ_PORT_CONSOLE=8161

# Memory
APIM_JAVA_OPTS=-Xms512m -Xmx1536m
APIM_MEM_LIMIT=3g
MI_JAVA_OPTS=-Xms256m -Xmx768m
MI_MEM_LIMIT=1200m
AMQ_JAVA_MEMORY=-Xms64m -Xmx384m
AMQ_MEM_LIMIT=600m
