# ---------------------------------------------------------------
# UAT environment  -  PLACEHOLDER (not started on this PC)
# Same services as dev, different ports/memory so it could run
# side-by-side on a bigger machine. Start with:  docker compose --env-file env/uat.env up -d
# ---------------------------------------------------------------
ENV_NAME=uat
COMPOSE_PROJECT_NAME=jamii-uat

APIM_IMAGE=wso2/wso2am:4.7.0
MI_BASE_IMAGE=wso2/wso2mi:4.6.0
ACTIVEMQ_IMAGE=apache/activemq-classic:5.18.7
SQLITE_IMAGE=keinos/sqlite3:3.46.1
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21

# dev ports + 10000
APIM_PORT_CONSOLE=19443
APIM_PORT_GW_HTTP=18280
APIM_PORT_GW_HTTPS=18243
MI_PORT_HTTP=18290
MI_PORT_HTTPS=18253
MI_PORT_MGMT=19164
AMQ_PORT_OPENWIRE=61617
AMQ_PORT_CONSOLE=18161

APIM_JAVA_OPTS=-Xms1g -Xmx2g
APIM_MEM_LIMIT=3g
MI_JAVA_OPTS=-Xms512m -Xmx1g
MI_MEM_LIMIT=1500m
AMQ_JAVA_MEMORY=-Xms128m -Xmx512m
AMQ_MEM_LIMIT=800m
