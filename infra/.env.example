# Optional local settings for `docker compose up` (dev).
# Copy to .env (git-ignored) - Compose reads it automatically.
# Anything not set here falls back to the defaults in compose.yaml.

# reqres.in API key used by CustomerProxy / GetCustomerByID / CustomerDashboardAPI.
# Without it those calls to reqres.in fail; everything else works.
REQRES_API_KEY=

# ActiveMQ broker + MI JMS login (default admin/admin, same as the web console)
# AMQ_USER=admin
# AMQ_PASSWORD=admin
